---
import { scheduleCopy } from "../data/hackathons";
import { featuredPresentations, speakingView } from "../data/presentations";
import MediaCarousel from "../components/media/MediaCarousel.astro";
import { sortedMediaArticles } from "../data/media";
import Layout from "../layouts/Layout.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import EditorialSectionHeader from "../components/editorial/EditorialSectionHeader.astro";
import EditorialContentRow from "../components/editorial/EditorialContentRow.astro";
import CollaborationCTA from "../components/editorial/CollaborationCTA.astro";
import { project, models, href } from "../data/project";
import PresentationThumbnail from "../components/speaking/PresentationThumbnail.astro";
import editorialTokens from "../styles/editorial-tokens.css?raw";
import editorialStyles from "../styles/editorial.css?raw";
import homepageStyles from "../styles/homepage-editorial.css?raw";
import researchCarousel from "../components/research-model-carousel.js?raw";
const presentations=featuredPresentations();
// Keep shared public stylesheet chunks unchanged: inline the existing opt-in source on Home only.
const styles=editorialTokens+'\n'+editorialStyles.replace(/^@import[^;]+;/,'')+'\n'+homepageStyles;
---
<Layout title={project.fullName}>
<div class="home-editorial" data-editorial>
<div class="home-band home-band--hero" data-home-surface="hero"><section class="home-editorial-hero ed-container" aria-labelledby="home-title">
  <div class="home-hero-copy"><p class="ed-meta">Open-source research initiative</p><h1 id="home-title">Intelligence,<br/><span class="home-headline-tail">with <em>boundaries.</em></span></h1><p class="home-fullname">{project.fullName}</p><p class="home-intro">{project.description}</p><div class="ed-actions"><a class="ed-action" href={href('research')}>Explore Research <span aria-hidden="true">↗</span></a><a class="ed-link" href={project.github} target="_blank" rel="noopener noreferrer">View on GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a></div></div>
    <div class="research-visual">
      <div class="visual-top">
        <span class="eyebrow">Authorization / evolving</span>
        <span class="visual-code">A → D</span>
      </div>
      <svg
        viewBox="0 0 420 330"
        role="img"
        aria-labelledby="hero-diagram-title hero-diagram-description"
      >
        <title id="hero-diagram-title">Implemented baselines and completed offline Model D research</title>
        <desc id="hero-diagram-description">
          Solid cyan layers represent implemented Models A, B and C. A double
          outer boundary represents completed experimental, non-enforcing offline Model D research.
        </desc>
        <defs>
          <pattern
            id="dots"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="1" cy="1" r="1" fill="var(--diagram-dots)" />
          </pattern>
        </defs>
        <rect width="420" height="330" fill="url(#dots)" />
        <g fill="none" stroke-width="1.5">
          <path
            d="M210 23 377 113v106L210 309 43 219V113Z"
            stroke="var(--amber)"
            stroke-width="3"
          />
          <path d="M210 29 371 117v98L210 303 49 215V117Z" stroke="var(--amber)" />
          <path d="m210 62 130 72v66l-130 71-130-71v-66Z" stroke="var(--diagram-c)" />
          <path d="m210 99 94 51v37l-94 51-94-51v-37Z" stroke="var(--diagram-b)" />
          <path
            d="m210 131 56 31v19l-56 30-56-30v-19Z"
            stroke="var(--cyan)"
            fill="var(--diagram-policy-bg)"
          />
          <path
            d="M210 23v108M377 219l-111-38M43 219l111-38"
            stroke="var(--diagram-connectors)"
          />
        </g>
        <g font-family="monospace" text-anchor="middle">
          <text x="210" y="178" fill="var(--diagram-label)" font-size="15">
            POLICY
          </text>
          <text x="210" y="54" fill="var(--amber)" font-size="11">
            D / OFFLINE
          </text>
          <text x="321" y="235" fill="var(--diagram-c-label)" font-size="11">
            C
          </text>
          <text x="281" y="211" fill="var(--diagram-b-label)" font-size="11">
            B
          </text>
          <text x="248" y="184" fill="var(--cyan)" font-size="11">
            A
          </text>
        </g>
        <g fill="var(--cyan)">
          <circle cx="210" cy="131" r="4" />
          <circle cx="266" cy="181" r="4" />
          <circle cx="154" cy="181" r="4" />
        </g>
      </svg>
      <div class="visual-bottom">
        <span class="eyebrow">The research direction</span>
        <p>
          From explicit rules.
          <br />
          <strong>Toward bounded adaptation.</strong>
        </p>
        <span class="microcopy">Model D · Research Implementation Complete</span>
      </div>
    </div>
</section>
<div class="home-research-strip ed-container"><span class="ed-meta">{project.tagline}</span><p>{project.theme}</p></div>
</div><section class="home-band home-band--paper home-progression" data-home-surface="research" aria-label="Research progression"><div class="ed-container home-progression-layout">
 <EditorialSectionHeader eyebrow="01 / Research progression" title="A baseline for every next step." description="Three implemented authorization baselines and a completed, experimental offline Model D research implementation."/>
 <a class="ed-link" href={href('research')}>Explore the Models <span aria-hidden="true">↗</span></a>
 <div class="home-model-rows" id="research-models" tabindex="0" role="region" aria-label="Research models A through D" aria-describedby="model-progression-help">{models.map(model=><EditorialContentRow index={model.id} title={model.name} description={model.description} metadata={`Model ${model.id} · ${model.status}`} href={href('research')} label={`Explore Model ${model.id}`}/>)}</div>
 <div class="home-model-controls" data-model-controls hidden><button type="button" data-model-prev aria-label="Previous research model" aria-controls="research-models">← Previous</button><span data-model-position role="status" aria-live="polite" aria-atomic="true"></span><button type="button" data-model-next aria-label="Next research model" aria-controls="research-models">Next →</button></div>
 <script is:inline data-model-carousel-init set:html={researchCarousel}/>
 <p class="home-progression-hint ed-meta" id="model-progression-help">Four research models: A → B → C → D. Swipe or scroll horizontally; keyboard users can focus the track and use arrow keys.</p>
 <aside class="home-research-note" aria-label="Research implementation boundary"><strong>A research progression, not a product maturity scale.</strong><p>Models A–C describe implemented baselines in the separate research repository; this portal does not independently validate their effectiveness. Model D research implementation is complete and non-enforcing (<code>enforcement_authority=NONE</code>), not a production authorization mechanism. Internal synthetic validation does not establish external field effectiveness or commercial readiness. Drift and mock-feedback limitations remain unresolved.</p></aside>
</div></section>
<section class="home-band home-band--architecture home-architecture" data-home-surface="architecture" aria-label="Research architecture"><div class="ed-container home-architecture-layout">
 <div class="home-architecture-intro"><EditorialSectionHeader eyebrow="02 / System perspective" title="Understand the boundary. Then explore the system." description="Investigating how identity, context, behavior and system state can inform authorization within explicit policy boundaries."/><a class="ed-link" href={href('architecture')}>Explore the architecture <span aria-hidden="true">↗</span></a></div>
 <ArchitectureDiagram/>
</div></section>
<section class="home-band home-band--mist" data-home-surface="question" aria-label="Central research question"><div class="ed-container home-question">
 <EditorialSectionHeader eyebrow="03 / The central question" title="What changes when authorization can adapt?"/>
 <div><p class="home-question-copy">{project.question}</p><p>Intelligent capabilities can be incorporated into system control loops while remaining bounded by deterministic engineering mechanisms, rather than simply added as an external service.</p><a class="ed-link" href={href('experiments')}>Toward reproducible experiments <span aria-hidden="true">↗</span></a></div>
</div></section>
<section class="home-band home-band--paper home-community" data-home-surface="community" aria-labelledby="home-community-heading"><div class="ed-container">
 <div class="home-section-top"><div><p class="ed-meta">04 / Build · Learn · Contribute</p><h2 id="home-community-heading">Build with the community.</h2></div><a class="ed-link" href={href('community')}>Explore the community <span aria-hidden="true">↗</span></a></div>

 <article class="home-event-row"><div><p class="ed-meta">AEGYTHON 2026</p><h3>Turn curiosity into working software.</h3><p>Explore the six challenges, qualification guidance and existing event program.</p><a class="ed-link" href={href('hackathons')}>Explore AEGYTHON 2026 <span aria-hidden="true">↗</span></a></div><div class="home-event-dates"><span class="ed-meta">Confirmed schedule</span><p>{scheduleCopy.summary}</p></div></article>
 <div class="home-future"><div><span class="ed-meta">Hackathon 2027</span><h3>Coming Soon</h3><p>A new chapter of innovation and collaboration. Details will be shared when officially confirmed.</p></div><a class="ed-link" href={href('hackathons/2027')}>Hackathon 2027 — Coming Soon <span aria-hidden="true">↗</span></a></div>
</div></section>
<section class="home-band home-band--media home-media" data-home-surface="media" aria-labelledby="featured-media-heading" id="featured-media"><div class="ed-container">
 <div class="home-section-top"><div><p class="ed-meta">05 / Media Coverage</p><h2 id="featured-media-heading">Featured in the Media</h2></div><a class="ed-link" href={href('media')}>View All Media Coverage <span aria-hidden="true">↗</span></a></div>
 <MediaCarousel articles={sortedMediaArticles()} id="featured-media-track" label="Featured media articles"/>
</div></section>
{presentations.length>0&&<section class="home-band home-band--hero home-speaking" data-home-surface="speaking" aria-labelledby="featured-presentations-heading"><div class="ed-container">
 <div class="home-section-top"><div><p class="ed-meta">06 / Speaking &amp; Presentations</p><h2 id="featured-presentations-heading">Research in conversation.</h2></div><a class="ed-link" href={href('speaking')}>View All Presentations <span aria-hidden="true">↗</span></a></div>
 <div class="home-speaking-preview"><figure><PresentationThumbnail presentation={presentations[0]}/><figcaption>Approved first-slide preview · Full PDF not published.</figcaption></figure><div>{presentations.map(p=><div data-presentation-slug={p.slug}><EditorialContentRow index="01" title={p.title} description={p.description} metadata={`${speakingView(p).status} · ${p.thumbnail?'First-slide preview · Full PDF not published':'Slides not yet available'}`} href={href(`speaking/${p.slug}`)} label="Explore presentation"/></div>)}</div></div>
</div></section>}
<div class="home-band home-band--collaboration home-closing" data-home-surface="collaboration"><div class="ed-container"><CollaborationCTA eyebrow="Work in the open" title="Follow the research as it develops." description="Research plans, architecture and work in preparation. Evidence will lead the conclusions." href={href('about')} label="About & Roadmap"/></div></div>
</div><style is:inline data-home-editorial set:html={styles}/>
</Layout>
