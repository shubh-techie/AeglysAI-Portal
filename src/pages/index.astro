---
import PresentationCard from "../components/speaking/PresentationCard.astro";
import { featuredPresentations } from "../data/presentations";
import MediaCarousel from "../components/media/MediaCarousel.astro";
import { sortedMediaArticles } from "../data/media";
import Layout from "../layouts/Layout.astro";
import ModelCard from "../components/ModelCard.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { project, models, href } from "../data/project";
const presentations = featuredPresentations();
---

<Layout title={project.fullName}>
  <section class="home-hero container">
    <div class="hero-copy">
      <div class="eyebrow hero-kicker">
        <span class="live-dot" aria-hidden="true"></span>Open-source research
        initiative
      </div>
      <h1>
        Aeglys<span>AI</span>
        <span class="hero-fullname">{project.fullName}</span>
      </h1>
      <p class="tagline">{project.tagline}</p>
      <p class="hero-description">{project.description}</p>
      <p class="hero-description">Intelligent capabilities can be incorporated into system control loops while remaining bounded by deterministic engineering mechanisms, rather than simply added as an external service.</p>
      <div class="actions">
        <a class="button button-primary" href={href("research")}>
          Explore Research <span aria-hidden="true">→</span>
        </a>
        <a
          class="button"
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub ↗<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
    <div class="research-visual">
      <div class="visual-top">
        <span class="eyebrow">Authorization / evolving</span>
        <span class="visual-code">A → D</span>
      </div>
      <svg
        viewBox="0 0 420 330"
        role="img"
        aria-labelledby="hero-diagram-title hero-diagram-description"
      >
        <title id="hero-diagram-title">Implemented baselines and completed offline Model D research</title>
        <desc id="hero-diagram-description">
          Solid cyan layers represent implemented Models A, B and C. A double
          outer boundary represents completed experimental, non-enforcing offline Model D research.
        </desc>
        <defs>
          <pattern
            id="dots"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="1" cy="1" r="1" fill="var(--diagram-dots)" />
          </pattern>
        </defs>
        <rect width="420" height="330" fill="url(#dots)" />
        <g fill="none" stroke-width="1.5">
          <path
            d="M210 23 377 113v106L210 309 43 219V113Z"
            stroke="var(--amber)"
            stroke-width="3"
          />
          <path d="M210 29 371 117v98L210 303 49 215V117Z" stroke="var(--amber)" />
          <path d="m210 62 130 72v66l-130 71-130-71v-66Z" stroke="var(--diagram-c)" />
          <path d="m210 99 94 51v37l-94 51-94-51v-37Z" stroke="var(--diagram-b)" />
          <path
            d="m210 131 56 31v19l-56 30-56-30v-19Z"
            stroke="var(--cyan)"
            fill="var(--diagram-policy-bg)"
          />
          <path
            d="M210 23v108M377 219l-111-38M43 219l111-38"
            stroke="var(--diagram-connectors)"
          />
        </g>
        <g font-family="monospace" text-anchor="middle">
          <text x="210" y="178" fill="var(--diagram-label)" font-size="15">
            POLICY
          </text>
          <text x="210" y="54" fill="var(--amber)" font-size="11">
            D / OFFLINE
          </text>
          <text x="321" y="235" fill="var(--diagram-c-label)" font-size="11">
            C
          </text>
          <text x="281" y="211" fill="var(--diagram-b-label)" font-size="11">
            B
          </text>
          <text x="248" y="184" fill="var(--cyan)" font-size="11">
            A
          </text>
        </g>
        <g fill="var(--cyan)">
          <circle cx="210" cy="131" r="4" />
          <circle cx="266" cy="181" r="4" />
          <circle cx="154" cy="181" r="4" />
        </g>
      </svg>
      <div class="visual-bottom">
        <span class="eyebrow">The research direction</span>
        <p>
          From explicit rules.
          <br />
          <strong>Toward bounded adaptation.</strong>
        </p>
        <span class="microcopy">Model D · Research Implementation Complete</span>
      </div>
    </div>
  </section>
  <div class="theme-band">
    <div class="container">
      <span class="eyebrow">Research theme</span>
      <p>{project.theme}</p>
    </div>
  </div>
  <section class="section container">
    <div class="section-heading-row">
      <SectionHeading
        eyebrow="01 / Research progression"
        title="A baseline for every next step."
        description="Three implemented authorization baselines and a completed, experimental offline Model D research implementation."
      />
      <a class="text-link" href={href("research")}>
        Explore the models <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="models-grid">
      {models.map((model) => (
        <ModelCard model={model} />
      ))}
    </div>
    <aside class="home-research-note" aria-label="Research implementation boundary"><strong>A research progression, not a product maturity scale.</strong><p>Models A–C describe implemented baselines in the separate research repository; this portal does not independently validate their effectiveness. Model D research implementation is complete and non-enforcing (<code>enforcement_authority=NONE</code>), not a production authorization mechanism. Internal synthetic validation does not establish external field effectiveness or commercial readiness. Drift and mock-feedback limitations remain unresolved.</p></aside>
  </section>
  <section class="section container architecture-section">
    <SectionHeading
      eyebrow="02 / System perspective"
      title="Evidence in. Explainable decisions out."
      description="Investigating how identity, context, behavior and system state can inform authorization within explicit policy boundaries."
    />
    <ArchitectureDiagram />
  </section>
  <section class="section container question-section">
    <div>
      <span class="eyebrow">03 / The central question</span>
      <h2>What changes when authorization can adapt?</h2>
    </div>
    <div>
      <p class="question-copy">{project.question}</p>
      <a class="text-link" href={href("experiments")}>
        Toward reproducible experiments <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="section container home-community" aria-labelledby="home-community-heading">
    <div class="section-heading-row"><div><span class="eyebrow">Build / Learn / Contribute</span><h2 id="home-community-heading">Build with the community.</h2></div><a class="text-link" href={href("community")}>Explore the community <span aria-hidden="true">→</span></a></div>
    <div class="home-community-grid">
      <article class="home-event-card"><span class="eyebrow">AEGYTHON 2026</span><h3>Turn curiosity into working software.</h3><p>Explore the six challenges, qualification guidance and existing event program.</p><a class="button button-primary" href={href("hackathons")}>Explore AEGYTHON 2026 <span aria-hidden="true">→</span></a></article>
      <article class="home-event-card home-event-future"><span class="eyebrow">Hackathon 2027</span><h3>Coming Soon</h3><p>A new chapter of innovation and collaboration. Details will be shared when officially confirmed.</p><a class="text-link" href={href("hackathons/2027")}>Hackathon 2027 — Coming Soon <span aria-hidden="true">→</span></a></article>
    </div>
  </section>
  <section class="section container" aria-labelledby="featured-media-heading" id="featured-media">
    <div class="section-heading-row"><div><span class="eyebrow">Media Coverage</span><h2 id="featured-media-heading">Featured in the Media</h2></div><a class="text-link" href={href("media")}>View All Media Coverage <span aria-hidden="true">→</span></a></div>
    <MediaCarousel articles={sortedMediaArticles()} id="featured-media-track" label="Featured media articles"/>
  </section>
  {presentations.length > 0 && <section class="section container" aria-labelledby="featured-presentations-heading">
    <div class="section-heading-row"><div><span class="eyebrow">Speaking &amp; Presentations</span><h2 id="featured-presentations-heading">Featured Presentations</h2></div><a class="text-link" href={href("speaking")}>View All Presentations <span aria-hidden="true">→</span></a></div>
    <div class="cards-grid three">{presentations.map(presentation => <PresentationCard presentation={presentation}/>)}</div>
  </section>}
  <section class="container closing-panel">
    <div>
      <span class="eyebrow">Work in the open</span>
      <h2>Follow the research as it develops.</h2>
      <p>
        Research plans, architecture and work in preparation. Evidence will lead
        the conclusions.
      </p>
    </div>
    <a class="button" href={href("about")}>
      About & Roadmap <span aria-hidden="true">→</span>
    </a>
  </section>
  <style is:inline data-home-experience>
    /* Homepage-only presentation; shared route/component styles remain untouched. */
    .home-hero { grid-template-columns: minmax(0, 1.15fr) minmax(0, .9fr); gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(3rem, 6vw, 6rem); }
    .hero-copy { min-width: 0; }
    .hero-kicker { width: fit-content; padding: .5rem .8rem; border: 1px solid var(--line); border-radius: 30px; background: var(--surface); font-size: .66rem; letter-spacing: .08em; }
    .home-hero h1 { font-size: clamp(3.5rem, 6.8vw, 6rem); line-height: 1.02; margin: 0; }
    .hero-fullname { font-size: clamp(1.65rem, 2.8vw, 2.65rem); line-height: 1.2; margin-top: 1.5rem; max-width: 21ch; }
    .tagline { margin-block: 1.5rem 0; font-size: .8rem; }
    .hero-description { max-width: 55ch; font-size: 1.05rem; line-height: 1.75; }
    .hero-description + .hero-description { font-size: .94rem; color: var(--muted); }
    .hero-copy .actions { gap: .75rem; margin-top: 1.75rem; }
    .hero-copy .button { min-height: 48px; padding: .85rem 1.1rem; }
    .research-visual { width: 100%; border-radius: 12px; background: linear-gradient(145deg, var(--panel-start), var(--surface)); overflow: hidden; }
    .research-visual svg { display: block; aspect-ratio: 420 / 330; max-height: 360px; }
    .visual-top, .visual-bottom { padding: 1.5rem; }
    .visual-bottom p { font-size: 1.35rem; line-height: 1.4; }
    .visual-top .eyebrow, .visual-bottom .eyebrow, .microcopy { font-size: .7rem; }
    .theme-band > .container { gap: 2rem; padding-block: 1.35rem; }
    .theme-band p { max-width: 65ch; line-height: 1.6; font-size: .9rem; }
    .section.container { padding-block: clamp(3rem, 5vw, 5rem); }
    .section-heading-row { align-items: flex-end; margin-bottom: 2rem; gap: 1.5rem; }
    .section .section-heading { max-width: 660px; margin-bottom: 2rem; }
    .section-heading-row .section-heading { margin-bottom: 0; }
    .section h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.2; letter-spacing: -.035em; }
    .section .section-heading p { font-size: 1rem; line-height: 1.75; max-width: 60ch; }
    .section .text-link { display: inline-flex; align-items: center; min-height: 44px; }
    .models-grid { gap: 1rem; }
    .models-grid .model-card { padding: 1.5rem; border-radius: 8px; background: linear-gradient(155deg, var(--surface), var(--theme-band)); }
    .models-grid .planned-card { background: var(--planned-wash); }
    .models-grid .model-top { margin-bottom: 1.5rem; }
    .models-grid .model-card h3 { font-size: 1.1rem; line-height: 1.4; min-height: 3.1rem; }
    .models-grid .model-card p { font-size: .9rem; line-height: 1.7; }
    .models-grid .badge { margin-top: auto; font-size: .65rem; }
    .home-research-note { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 1.5rem; margin-top: 1.5rem; padding: 1.5rem; border: 1px solid var(--line); border-left: 3px solid var(--amber); border-radius: 6px; background: var(--surface); }
    .home-research-note strong { font-size: 1rem; line-height: 1.5; color: var(--text); }
    .home-research-note p { margin: 0; font-size: .9rem; color: var(--muted); line-height: 1.7; }
    .home-research-note code { overflow-wrap: anywhere; }
    .architecture-section .architecture { padding: clamp(1rem, 3vw, 2.5rem); border-radius: 10px; }
    .architecture-section .diagram-header { gap: 1rem; flex-wrap: wrap; }
    .architecture-section .diagram-legend { font-size: .8rem; gap: 1rem; }
    .architecture-section .diagram-node { padding: 1.3rem .75rem; font-size: .95rem; line-height: 1.4; }
    .architecture-section .diagram-node small { font-size: .72rem; line-height: 1.5; }
    .architecture-section .planned-strip { font-size: .8rem; padding: 1rem; }
    .architecture-section figcaption { font-size: .85rem; line-height: 1.75; }
    .question-section { border-block: 1px solid var(--line); }
    .question-section .question-copy { font-size: 1.05rem; line-height: 1.8; }
    .home-community-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 1.25rem; }
    .home-event-card { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--panel-border); border-radius: 10px; background: linear-gradient(140deg, var(--panel-start), var(--surface)); }
    .home-event-card h3 { margin: 1rem 0; font-size: clamp(1.4rem, 2vw, 1.8rem); line-height: 1.3; letter-spacing: -.025em; }
    .home-event-card p { margin: 0 0 1.5rem; color: var(--muted); }
    .home-event-card a { margin-top: auto; min-height: 48px; }
    .home-event-future { border-color: var(--line); background: var(--surface); }
    #featured-media .section-heading-row { margin-bottom: 2rem; }
    #featured-media .media-card, .section .presentation-card { border-radius: 10px; }
    #featured-media .media-body { padding: 1.5rem; }
    #featured-media .media-card h3 { -webkit-line-clamp: unset; font-size: 1.05rem; line-height: 1.5; }
    #featured-media .media-controls { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; max-width: 430px; margin-inline: auto; gap: .5rem; }
    #featured-media .media-controls[hidden] { display: none; }
    #featured-media .media-pagination { display: flex; flex-wrap: wrap; justify-content: center; }
    #featured-media .media-pagination button { width: 44px; min-width: 44px; height: 44px; }
    .closing-panel { margin-top: 2rem; margin-bottom: 4rem; padding: clamp(1.5rem, 4vw, 3rem); border-radius: 10px; gap: 2rem; }
    .closing-panel h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.25; }
    .closing-panel p { max-width: 56ch; line-height: 1.75; }
    @media (max-width: 1100px) { .models-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 960px) {
      .home-hero { grid-template-columns: 1fr; }
      .hero-copy { max-width: 680px; }
      .research-visual { max-width: 580px; margin: 0; }
      .hero-fullname { max-width: 25ch; }
      .home-research-note { grid-template-columns: 1fr; gap: .75rem; }
      .architecture-section .engine-grid { grid-template-columns: 1fr; }
      .architecture-section .inline-arrow { transform: rotate(90deg); line-height: 30px; }
      .architecture-section .input-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 600px) {
      .home-hero { padding-block: 2.5rem 3rem; gap: 2.5rem; }
      .hero-copy .actions { display: grid; grid-template-columns: 1fr; }
      .hero-copy .button { justify-content: center; }
      .models-grid, .home-community-grid { grid-template-columns: 1fr; }
      .models-grid .model-card h3 { min-height: 0; }
      .section-heading-row { display: block; }
      .section-heading-row > .text-link { margin: .75rem 0 0; white-space: normal; }
      .home-event-card a { white-space: normal; }
      .architecture-section .decision-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .architecture-section .planned-strip { display: block; }
      .architecture-section .planned-strip span { display: block; margin-top: .5rem; }
      .theme-band > .container { display: block; }
      .theme-band p { margin-top: .5rem; }
    }
  </style>
</Layout>
