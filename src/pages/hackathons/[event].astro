---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import HackathonNav from '../../components/HackathonNav.astro';
import { legacyEvents } from '../../data/hackathons';
import { href } from '../../data/project';
export function getStaticPaths(){return legacyEvents.map(event=>({params:{event:event.id},props:{event}}));}
const {event}=Astro.props;
---
<Layout title={`${event.title} — Retired Proposal`} description={`Retired ${event.title} proposal. The current AEGYTHON 2026 hackathon is one event with six challenge choices.`}><Hero eyebrow="Retired proposal / Compatibility link" title={event.title} description="This proposed separate event has been superseded. No completed event is claimed and its former dates are not current announcements."/><div class="container page-content"><HackathonNav/><section class="section"><h2>Follow the current hackathon</h2><a class="text-link" href={href('hackathons/events')}>Six challenges and finalized participation rules →</a><p><a href={`${href('hackathons')}#qualification`}>Mandatory qualification →</a> · <a href={`${href('hackathons')}#certificates`}>Certificate eligibility →</a></p></section></div></Layout>
