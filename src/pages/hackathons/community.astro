---
import { hackathonSeo, hackathonSocialPreview } from "../../data/hackathonSeo";
import Layout from "../../layouts/Layout.astro";
import EventShowcase from "../../components/showcase/EventShowcase.astro";
import { approvedEventShowcase } from "../../data/eventRegistryInput";
import Hero from "../../components/Hero.astro";
import CreatorProfile from "../../components/CreatorProfile.astro";
import HackathonPersonCard from "../../components/HackathonPersonCard.astro";
import HackathonRegistration from "../../components/HackathonRegistration.astro";
import FormCta from "../../components/hackathons/FormCta.astro";
import HackathonNav from "../../components/HackathonNav.astro";
import { speakers, judges, statusDefinitions } from "../../data/hackathons";
---
<Layout title={hackathonSeo.community.title} description={hackathonSeo.community.description} socialImage={hackathonSocialPreview.image}>
  <Hero eyebrow="Community / People" title="Engineering grows through exchange." description="A planned space for practitioners and researchers to share methods, critique evidence and improve secure distributed systems." />
  <div class="container page-content"><HackathonNav />
    <section class="section" aria-labelledby="keynote-heading"><h2 id="keynote-heading">About the AeglysAI creator</h2><p>This is the existing project profile, not a confirmed hackathon speaking appointment.</p><CreatorProfile /></section>
    {[{title: "Guest Speakers", slots: speakers, note: "Three guest speaker roles are available. Profiles are published only after confirmation and permission to display the approved information."}, {title: "Judges", slots: judges, note: "Independent judges review technical evidence and disclose conflicts of interest. Profiles and event assignments are published only after confirmation and public-profile approval."}].map(group => <section class="section"><h2>{group.title}</h2><p>{group.note}</p><div class="cards-grid three">{group.slots.map(slot => <HackathonPersonCard entry={slot} />)}</div>{group.title === "Judges" && <div class="actions"><HackathonRegistration kind="judge" /></div>}</section>)}
    <section class="section"><h2>Participants</h2><p>Participation is free. Choose a challenge, review the official terms when finalized, register through the official form when opened, then individually fork, clone and run the A/B/C baseline and submit qualification evidence. Qualification does not guarantee selection. Every member of a one-to-four-person team must be qualified and selected. No participant roster, attendance counts or submissions are announced.</p><p>Applications will initially be handled through Google Forms/Drive. Application details are kept separate from public community profiles.</p><div class="actions"><HackathonRegistration id="community-participant-registration" /><a class="button" href="/hackathons/#qualification">Prepare qualification evidence</a></div></section>
    <section class="section"><h2>Speakers, mentors and invited guests</h2><p>Profiles require confirmed participation and explicit publication approval; organizer contacts remain private.</p><div class="actions"><FormCta kind="speaker" label="Speaker / Mentor Profile" id="community-speaker-note"/><FormCta kind="guest" label="Respond to Guest Invitation" id="community-guest-note"/></div></section>
    <section class="section"><h2>Community Partners</h2><p>Community collaboration is planned. No partners or sponsors have been confirmed or announced.</p></section>
    <EventShowcase id="aegython-showcase" eventId="aegython-2026" title={"People & Partners"} description="Judges, speakers, mentors, organizers and partners appear only after role, content, affiliation, image-rights and publication approval. Source Pending or Approved labels alone are insufficient." data={approvedEventShowcase} />
    <section class="notice"><h2>Reading program status</h2><dl class="program-status-guide">{Object.entries(statusDefinitions).map(([status, meaning]) => <><dt>{status}</dt><dd>{meaning}</dd></>)}</dl><p>Events and unfilled roles remain PLANNED. Invited profiles are not published; public guest speaker and judge profiles require CONFIRMED status and explicit display approval. No completed events or winners are claimed.</p></section>
  </div>
</Layout>

<style is:inline data-final-people-style>
  #aegython-showcase-items .showcase-card img, #aegython-showcase-items .showcase-fallback { width: 9rem; height: 9rem; border-radius: 50%; object-fit: cover; aspect-ratio: 1; }
  .event-showcase select:focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }
  #aegython-showcase-title { scroll-margin-top: 6rem; }
</style>
