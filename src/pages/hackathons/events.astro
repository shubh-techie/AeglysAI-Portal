---
import { hackathonSeo, hackathonSocialPreview } from '../../data/hackathonSeo';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import HackathonNav from '../../components/HackathonNav.astro';
import ChallengeDiagram from "../../components/hackathons/ChallengeDiagram.astro";
import {challengeVisuals} from "../../data/hackathonVisuals";
import HackathonRules from '../../components/hackathons/HackathonRules.astro';
import { challenges, legacyEvents } from '../../data/hackathons';
import { href } from '../../data/project';
---
<Layout title={hackathonSeo.events.title} description={hackathonSeo.events.description} socialImage={hackathonSocialPreview.image}>
<Hero eyebrow="One hackathon / Six challenges" title="Build a working idea." description="Mandatory individual qualification, teams of one to four, executable projects and two-round judging. Registration Opening Soon; dates to be announced."/>
<div class="container page-content"><HackathonNav/><section class="section"><h2>Choose one challenge</h2><div class="challenge-detail-list">{challenges.map((track,index)=><article class="info-card challenge-detail" id={track.id}><div><p class="eyebrow">Challenge {String(index+1).padStart(2,'0')} · {challengeVisuals[track.id].difficulty??'Beginner-friendly'}</p><h3>{track.title}</h3><p>{challengeVisuals[track.id].problem}</p><p><strong>Focus:</strong> {challengeVisuals[track.id].focus}</p><p><strong>Minimum prototype:</strong> {challengeVisuals[track.id].minimum}</p><p>Any language or framework. Standalone implementations are accepted after mandatory AeglysAI qualification. Include an offline entrypoint, setup/input/output documentation, normal/edge/invalid-input tests and known limitations.</p>{challengeVisuals[track.id].examples&&<><h4>Example areas</h4><ul>{challengeVisuals[track.id].examples!.map(area=><li>{area}</li>)}</ul><h4>Challenge requirements</h4><ul>{challengeVisuals[track.id].requirements!.map(rule=><li>{rule}</li>)}</ul><p>This sixth challenge is a Portal-approved extension; the research COM-003A offering currently defines five tracks. Upstream alignment is pending.</p></>}<a class="text-link" href="#submission">Full submission requirements →</a> · <a class="text-link" href={`${href('hackathons')}#qualification`}>Mandatory qualification →</a></div><ChallengeDiagram id={track.id} scope="detail"/></article>)}</div></section><HackathonRules/><section class="section"><h2>Legacy proposal links</h2><p>The former three-event proposal has been replaced by this single hackathon. These URLs are retained for compatibility; their dates and prizes are not current event announcements.</p><ul>{legacyEvents.map(event=><li id={event.id}><a href={href(`hackathons/${event.id}`)}>{event.title} — retired proposal</a></li>)}</ul></section></div></Layout>

<style>.challenge-detail-list{display:grid;gap:28px;margin-top:28px;}.challenge-detail{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:32px;align-items:center;scroll-margin-top:30px;}.challenge-detail p{margin-top:16px;}@media(max-width:760px){.challenge-detail{grid-template-columns:1fr;gap:24px;}}</style>
