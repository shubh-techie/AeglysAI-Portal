---
import Layout from "../layouts/Layout.astro";
import EditorialSectionHeader from "../components/editorial/EditorialSectionHeader.astro";
import Hero from "../components/Hero.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { papers, href } from "../data/project";
import { publishedPresentations } from "../data/presentations";
import { creator } from "../data/creator";
const presentations = publishedPresentations();
---

<Layout
  title="Publications"
  description="AeglysAI research papers and technical publications in preparation. No publication or conference acceptance is claimed."
>
  <div class="editorial-alignment alignment-publications">
  <Hero
    eyebrow="04 / Publications"
    title="AeglysAI Research"
    description="Research papers and technical publications from the evolving research program. Current manuscripts remain in preparation; no publication or conference acceptance is claimed."
  />
  <div class="container page-content">
    <p class="scholar-note">
      Creator profile:{" "}
      <a
        class="text-link"
        href={creator.links.scholar}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${creator.name} on Google Scholar (opens in a new tab)`}
      >
        {creator.name} on Google Scholar <span aria-hidden="true">↗</span>
      </a>
    </p>
    <section>
      <EditorialSectionHeader eyebrow="Writing in progress" title="Research papers" />
      <div class="publication-list">
        {papers.map((title, index) => (
          <article id={`paper-${index + 1}`}>
            <span class="publication-number">P / 0{index + 1}</span>
            <div>
              <StatusBadge status="In Preparation" />
              <h3>{title}</h3>
              <p>Working title · Manuscript in preparation</p>
              {presentations.filter(talk => talk.relatedPaperTitles?.includes(title)).map(talk => <p><a class="text-link" href={href(`speaking/${talk.slug}`)}>Associated presentation: {talk.title} →</a></p>)}
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="section">
      <EditorialSectionHeader eyebrow="Speaking & Presentations" title="Looking for talks?" />
      <p>Presentation previews, invitations and proposed talks are now collected in <a class="text-link" href={href('speaking')}>Speaking & Presentations →</a>.</p>
    </section>
    <section class="notice">
      <span class="eyebrow">Literature context</span>
      <h2>Related Research</h2>
      <p>
        A curated list of verified related research will be added after the
        literature review. References and publication metadata are not yet
        available.
      </p>
    </section>
  </div>
</div>
</Layout>
