---
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/speaking/showcase/EventCard.astro';
import { speakingShowcase, featuredSpeakingEvent, speakingResources, proposedSpeakingTopics } from '../../data/speakingContent';
import { youtubeUrl } from '../../data/speakingShowcase';
import { asset, href } from '../../data/project';
import { creator } from '../../data/creator';
import galleryScript from '../../components/speaking/showcase/gallery.js?raw';
import '../../styles/speaking-showcase.css';
const filters=[{id:'completed',label:'Completed'},{id:'confirmed',label:'Confirmed engagement'},{id:'awaiting',label:'Awaiting confirmation'}];
const cover=speakingResources.find(p=>p.slug===featuredSpeakingEvent?.presentationId)?.thumbnail;
---
<Layout title="Speaking & Technical Presentations" description="Research conversations, verified conference engagements, technical resources and AeglysAI community recordings. Event participation, delivery and media availability are stated separately.">
<div class="sp-showcase" data-speaking-showcase data-schema-version={speakingShowcase.schemaVersion}>
 <section class="sp-hero container" aria-labelledby="speaking-title">
  <div><p class="sp-kicker">AEGLYSAI / RESEARCH EXCHANGE</p><h1 id="speaking-title">Research,<br/><span>in conversation.</span></h1><p class="sp-lead">Technical talks and open discussions on adaptive security, policy-bounded AI and resilient distributed systems.</p><p class="sp-hero-note">Ideas worth sharing. Context worth keeping.</p></div>
  <nav class="sp-section-index" aria-label="Speaking sections"><a href="#engagements"><span>01</span> Conference engagements <span aria-hidden="true">↘</span></a><a href="#recordings"><span>02</span> Watch & learn <span aria-hidden="true">↘</span></a><a href="#slide-library"><span>03</span> Technical resources <span aria-hidden="true">↘</span></a></nav>
 </section>
 <div class="container sp-content">
  {featuredSpeakingEvent&&<section class="sp-section" aria-labelledby="featured-engagement-heading">
   <div class="sp-section-heading"><div><p class="sp-kicker">FEATURED / TECHNICAL ENGAGEMENT</p><h2 id="featured-engagement-heading">From research to the room.</h2></div><span class="sp-small-label">{featuredSpeakingEvent.shortName}</span></div>
   <div class="sp-featured-grid"><EventCard event={featuredSpeakingEvent} featured/>{cover&&<figure class="sp-cover"><div class="sp-cover-label"><span>THE TALK</span><span aria-hidden="true">↗</span></div><a href={href(`speaking/${featuredSpeakingEvent.presentationId}`)} aria-label={`Explore ${featuredSpeakingEvent.talkTitle}`}><img src={asset(cover.path)} alt="First-slide preview: Beyond Static Access Control" width="960" height="540" loading="lazy" decoding="async"/></a><figcaption>Approved first-slide preview. Full PDF not published.</figcaption></figure>}</div>
  </section>}
  <section id="engagements" class="sp-section" aria-labelledby="engagements-heading">
   <div class="sp-section-heading"><div><p class="sp-kicker">01 / CONFERENCE ENGAGEMENTS</p><h2 id="engagements-heading">Every event has its context.</h2></div><p>Completed talks, confirmed engagements<br/>and invitations awaiting confirmation.</p></div>
   <div class="sp-engagement-gallery"><fieldset class="sp-filters"><legend class="sr-only">Filter conference engagements</legend><label><input type="radio" name="engagement-filter" id="engagement-all" checked/><span>All engagements</span></label>{filters.map(f=><label><input type="radio" name="engagement-filter" id={`engagement-${f.id}`}/><span>{f.label}</span></label>)}</fieldset><div class="sp-event-grid">{speakingShowcase.events.map(event=><EventCard event={event}/>)}</div></div>
  </section>
  <section id="recordings" class="sp-section" aria-labelledby="recordings-heading">
   <div class="sp-section-heading"><div><p class="sp-kicker">02 / WATCH & LEARN</p><h2 id="recordings-heading">Keep the conversation going.</h2></div><p>AEGYTHON 2026 community recordings<br/>from the AeglysAI channel.</p></div>
   <div class="sp-recording-grid">{speakingShowcase.recordings.map((recording,i)=><article class="sp-recording" data-recording-id={recording.id}>
    <a class="sp-video-visual" href={youtubeUrl(recording.id)} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${recording.title} on YouTube (opens in a new tab)`}><span class="sp-video-index">{String(i+1).padStart(2,'0')} / AEGYTHON 2026</span><span class="sp-play" aria-hidden="true">▶</span><span class="sp-video-caption">THE CONVERSATION CONTINUES <span aria-hidden="true">↗</span></span></a>
    <div class="sp-recording-copy"><p class="sp-kicker">{recording.context}</p><h3>{recording.title}</h3><p>YouTube · {recording.channel}</p><a href={youtubeUrl(recording.id)} target="_blank" rel="noopener noreferrer">Watch recording <span aria-hidden="true">↗</span><span class="sr-only">: {recording.title} (opens in a new tab)</span></a></div>
   </article>)}</div><p class="sp-footnote">Videos open on YouTube when selected. No video player or third-party thumbnail loads with this page.</p>
  </section>
  <section id="slide-library" class="sp-section" aria-labelledby="library-heading">
   <div class="sp-section-heading"><div><p class="sp-kicker">03 / TECHNICAL RESOURCES</p><h2 id="library-heading">Take the ideas further.</h2></div><p>Approved previews and technical material.<br/>Availability is independent of event delivery.</p></div>
   <div class="sp-resource-list">{speakingResources.map(p=><article class="sp-resource" data-presentation-slug={p.slug}><span class="sp-resource-number" aria-hidden="true">01</span><div><p class="sp-kicker">PRESENTATION RESOURCE</p><h3>{p.title}</h3><p>{p.description}</p><p class="sp-footnote">{p.pdf?'Approved PDF available':'First-slide preview · Full PDF not published'}</p></div><a href={href(`speaking/${p.slug}`)}>Explore presentation <span aria-hidden="true">↗</span><span class="sr-only">: {p.title}</span></a></article>)}</div>
   <div class="sp-proposals" aria-labelledby="proposed-heading"><p class="sp-kicker">PROPOSED / IN PREPARATION</p><h3 id="proposed-heading">Questions for future conversations.</h3><div class="sp-proposal-grid">{proposedSpeakingTopics.map(p=><article data-presentation-slug={p.slug}><span class="sp-status">Proposed · In Development</span><h4>{p.title}</h4><p>{p.description}</p><a href={href(`speaking/${p.slug}`)}>Explore topic <span aria-hidden="true">↗</span><span class="sr-only">: {p.title}</span></a></article>)}</div></div>
  </section>
  <section class="sp-collaboration sp-section" aria-labelledby="collaboration-heading"><div><p class="sp-kicker">OPEN QUESTIONS / SHARED LEARNING</p><h2 id="collaboration-heading">Bring a hard question.<br/>Start a useful conversation.</h2><p>Research discussions and technical exchanges on explainable security, policy-bounded adaptation and resilient systems.</p></div><a class="button button-primary" href={creator.links.github} target="_blank" rel="noopener noreferrer">Discuss research on GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></section>
 </div>
 <dialog class="sp-lightbox" data-speaking-lightbox aria-labelledby="speaking-photo-heading"><div class="sp-lightbox-toolbar"><h2 id="speaking-photo-heading">Conference photograph</h2><button type="button" data-photo-close>Close <span aria-hidden="true">×</span></button></div><figure><img alt="" width="1280" height="960"/><figcaption data-photo-description></figcaption></figure><div class="sp-lightbox-controls"><button type="button" data-photo-prev aria-label="Previous photograph">← Previous</button><p data-photo-counter aria-live="polite"></p><button type="button" data-photo-next aria-label="Next photograph">Next →</button></div><a data-original-photo>Open full image</a></dialog>
</div>
<script is:inline data-speaking-gallery-init set:html={galleryScript}/>
</Layout>
