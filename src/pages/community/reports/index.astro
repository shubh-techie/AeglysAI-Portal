---
import Layout from '../../../layouts/Layout.astro';import Hero from '../../../components/Hero.astro';import CommunityNav from '../../../components/community/CommunityNav.astro';import { reports } from '../../../data/community/reports';import { href } from '../../../data/project';
const openMonth=new Date().toISOString().slice(0,7);
---
<Layout title="Community Impact Reports" description="Reviewed monthly AeglysAI impact reporting archives, with revision provenance, source snapshots and open-period limitations."><Hero eyebrow="Community / Reports" title="Reporting with a visible audit trail." description="Closed-period reports require review before publication. Drafts never appear in this archive."/><div class="container page-content"><CommunityNav/><section><h2>Monthly archive</h2>{reports.length?<ul>{reports.map(report=><li><a href={href(`community/reports/${report.month}`)}>{report.month} · Revision {report.revision}</a></li>)}</ul>:<div class="notice"><p>No approved monthly reports published.</p><p>{openMonth} remains an open reporting period until UTC month-end. Current cumulative repository counts cannot reconstruct missing historical snapshots.</p><p>The published COM-008A 1.0.0 contract is pinned to a verified research revision. Each report still requires separate owner authorization and verified closed-period evidence before publication.</p></div>}</section></div></Layout>
