---
import Layout from '../../../layouts/Layout.astro';import Hero from '../../../components/Hero.astro';import CommunityNav from '../../../components/community/CommunityNav.astro';import {asset} from '../../../data/project';import {reports} from '../../../data/community/reports';
export function getStaticPaths(){return reports.map(report=>({params:{month:report.month},props:{report}}));}
const {report}=Astro.props;const contract=report.contract;
---
<Layout title={`Community Report — ${report.month}`} description={`Reviewed ${report.month} impact report revision ${report.revision}, with evidence coverage, quality and correction history.`}><Hero eyebrow="Community / Reviewed report" title={`Impact report: ${report.month}`} description={`Revision ${report.revision}; ${contract.data_quality.status} data quality. Evidence levels remain distinct.`}/><div class="container page-content"><CommunityNav/><p><a href={asset(`community/reports/${report.month}.json`)} download>Download JSON</a> · <a href={asset(`community/reports/${report.month}.md`)} download>Download Markdown</a></p><section><h2>Reviewed measures</h2>{contract.metrics.map((metric:any)=><article class="info-card"><h3>{metric.definition}</h3><p>{metric.value} {metric.unit} · {metric.coverage} · {metric.verification.status}</p><ul>{metric.limitations.map((line:string)=><li>{line}</li>)}</ul></article>)}</section><section class="section"><h2>Source provenance</h2><ul>{contract.source_snapshots.map((source:any)=><li>{source.id} · SHA-256 <code>{source.sha256}</code><ul>{source.record.metrics.map((metric:any)=><li><a href={metric.source.reference} target="_blank" rel="noopener noreferrer">Evidence source ↗</a> · {metric.period.start} – {metric.period.end}</li>)}</ul></li>)}</ul><h2>Revision history</h2><p>{contract.revision.reason}</p><ul>{contract.revision.history.map((prior:any)=><li>Revision {prior.revision} · SHA-256 <code>{prior.sha256}</code></li>)}</ul><p>Publication review: <a href={contract.publication.review_reference} target="_blank" rel="noopener noreferrer">Approved review ↗</a> · {contract.publication.approved_at}</p></section></div></Layout>
