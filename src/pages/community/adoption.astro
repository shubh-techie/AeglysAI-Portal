---
import Layout from '../../layouts/Layout.astro';import Hero from '../../components/Hero.astro';import CommunityNav from '../../components/community/CommunityNav.astro';import ReviewedGallery from '../../components/community/ReviewedGallery.astro';import { adoptions,adoptionCategories } from '../../data/community/adoption';
---
<Layout title="Independent Technical Use" description="Evidence-backed external AeglysAI integrations, reproductions, academic references and implementations, with provenance and limits."><Hero eyebrow="Community / Independent use" title="What technical evidence demonstrates." description="Stars, forks and registrations do not establish independent adoption or research effectiveness."/><div class="container page-content"><CommunityNav/><section><h2>Evidence categories</h2><dl>{adoptionCategories.map(([title,definition])=><div><dt>{title}</dt><dd>{definition}</dd></div>)}</dl></section><section class="section"><h2>Reviewed technical evidence</h2><ReviewedGallery records={adoptions} categories={adoptionCategories.map(([title])=>title)} kind="adoption"/></section></div></Layout>
<style>dl{display:grid;gap:20px;}dt{font-weight:600;}dd{margin:8px 0 0;color:var(--muted);line-height:1.7;}</style>
