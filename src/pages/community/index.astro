---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import CommunityNav from '../../components/community/CommunityNav.astro';
import { href } from '../../data/project';
---
<Layout title="Community" description="Explore AeglysAI community participation, verified project evidence and research-impact reporting with transparent publication boundaries."><Hero eyebrow="AeglysAI Community" title="Build, reproduce, share evidence." description="Technical contributions and independent research deserve clear sources, reproducible methods and honest limitations."/><div class="container page-content"><CommunityNav/><div class="cards-grid three">{[['Impact dashboard','Source-linked observations and reviewed aggregate evidence.','impact'],['Community projects','Verified projects published with explicit permission.','projects'],['Independent use','External integrations, reproductions and references with provenance.','adoption']].map(([title,description,path])=><article class="info-card"><h2>{title}</h2><p>{description}</p><a class="text-link" href={href(`community/${path}`)}>Explore {title} →</a></article>)}</div><section class="section"><h2>Contribute a technical project</h2><p>The research repository provides one technical offering with five challenge choices. Event intake remains closed until an approved private service is supplied.</p><a class="text-link" href={href('community/submit')}>Submission preparation →</a></section></div></Layout>
