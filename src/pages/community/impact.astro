---
import Layout from '../../layouts/Layout.astro';import Hero from '../../components/Hero.astro';import CommunityNav from '../../components/community/CommunityNav.astro';import MetricGrid from '../../components/community/MetricGrid.astro';import {recognitions} from '../../data/community/recognition';import { evidence } from '../../data/community/evidence';
---
<Layout title="Community Impact" description="AeglysAI GitHub observations and reviewed community aggregates, with unavailable data and research-impact limits explicitly identified."><Hero eyebrow="Community / Impact" title="Evidence before impact claims." description="Repository activity, participation and independent technical outcomes are distinct measures."/><div class="container page-content"><CommunityNav/><section><h2>GitHub observations</h2><MetricGrid/></section><section class="section"><h2>Reviewed community evidence</h2>{evidence?<div class="cards-grid three">{evidence.metrics.map((metric:any)=><article class="info-card"><h3>{metric.definition}</h3><p>{metric.count} {metric.unit}</p><p>{metric.period.start} – {metric.period.end}</p><a class="text-link" href={metric.source.reference} target="_blank" rel="noopener noreferrer">Evidence source ↗</a><p>{metric.limitations.join(' ')}</p></article>)}</div>:<div class="notice"><p>Hackathon participation: Unavailable</p><p>Verified submissions: Unavailable</p><p>Research reproduction activity: Unavailable</p><p>Independent adoption: Unavailable</p><p>No reviewed COM-001 public aggregate is available. Missing records are not evidence of zero activity.</p></div>}</section><section class="section"><h2>Reviewed contributor recognition</h2>{recognitions.length?<ul>{recognitions.map(record=><li>{record.credit_mode==='anonymous'?'Anonymous contribution credit':'Artifact contribution credit'} · <time datetime={record.recorded_at}>{record.recorded_at.slice(0,10)}</time>{record.credit_mode==='artifact-only'&&record.contribution_reference&&<a class="text-link" href={record.contribution_reference} target="_blank" rel="noopener noreferrer"> Reviewed contribution ↗</a>}</li>)}</ul>:<p>No approved public contributor recognition records available.</p>}</section></div></Layout>
