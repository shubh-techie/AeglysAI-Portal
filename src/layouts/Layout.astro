---
import { socialPreview } from "../data/social";
import type { SocialImage } from "../data/hackathonSeo";
import ThemeInit from "../components/ThemeInit.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { creator } from "../data/creator";
import { project, asset } from "../data/project";
import "../styles/global.css";
import { editorialPresentation } from "./editorial-policy";
import editorialTokens from "../styles/editorial-tokens.css?raw";
import editorialBase from "../styles/editorial.css?raw";
import editorialAlignment from "../styles/editorial-alignment.css?raw";
import editorialPageStyles from "../styles/editorial-page.css?raw";
const presentation = editorialPresentation(Astro.url.pathname);
const editorialCSS = editorialTokens+editorialBase.replace(/^@import[^;]+;/,'')+editorialAlignment+editorialPageStyles;
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  socialImage?: SocialImage | null;
}
const {
  title,
  description = project.description,
  noindex = false,
  socialImage = socialPreview,
} = Astro.props;
const fullTitle = `${title} | AeglysAI Research`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = socialImage ? new URL(asset(socialImage.path), Astro.site) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#080f1c" />
    <ThemeInit />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={creator.name} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AeglysAI Research" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && socialImageUrl && <>
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={socialImage.alt} />
      <meta property="og:image:width" content={String(socialImage.width)} />
      <meta property="og:image:height" content={String(socialImage.height)} />
      <meta name="twitter:image" content={socialImageUrl} />
      <meta name="twitter:image:alt" content={socialImage.alt} />
    </>}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={asset("brand/icons/favicon.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("brand/icons/icon-180.png")} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class={presentation.editorial?"editorial-page":undefined} data-editorial={presentation.editorial||undefined} data-editorial-page={presentation.editorial||undefined}>
      <slot />
      {presentation.editorial&&<style is:inline data-editorial-page-styles set:html={editorialCSS}/>}
    </main>
    <Footer editorial={presentation.editorialFooter}/>
  </body>
</html>
