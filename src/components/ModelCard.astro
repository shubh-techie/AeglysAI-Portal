---
import StatusBadge from "./StatusBadge.astro";
import type { models } from "../data/project";
interface Props {
  model: (typeof models)[number];
}
const { model } = Astro.props;
---

<article class:list={["model-card", { "research-complete": model.status === "Research Implementation Complete" }]}>
  <div class="model-top">
    <span class="eyebrow">Model {model.id}</span>
    <span class="model-letter" aria-hidden="true">
      {model.id}
    </span>
  </div>
  <h3>{model.name}</h3>
  <p>{model.description}</p>
  <StatusBadge status={model.status} />
</article>

<style is:inline>
.model-card.research-complete { border: 3px double var(--cyan); background: var(--surface); }
</style>
