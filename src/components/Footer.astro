---
import { project, href } from "../data/project";
import { creator } from "../data/creator";
import BrandMark from "./BrandMark.astro";
import CreatorLinks from "./CreatorLinks.astro";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-project">
      <a class="wordmark" href={href()} aria-label="AeglysAI home">
        <BrandMark />
        Aeglys<span>AI</span>
      </a>
      <p>{project.fullName}</p>
      <p>
        Open-source research initiative created and maintained by{" "}
        <a href={`${href("about")}#creator-heading`}>{creator.name}</a>.
      </p>
    </div>
    <div class="footer-note">
      <span class="eyebrow">Open research / evolving work</span>
      <p>Models A–C implemented. Model D research implementation complete; experimental and non-enforcing.</p>
      <CreatorLinks />
    </div>
    <a
      class="text-link"
      href={project.github}
      target="_blank"
      rel="noopener noreferrer"
    >
      Research repository ↗<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</footer>
