---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { SpeakingPhoto } from '../../../data/speakingShowcase';
interface Props { photos: SpeakingPhoto[]; eventName: string; }
const {photos,eventName}=Astro.props;
const loaders=import.meta.glob<{default:ImageMetadata}>('/src/assets/speaking/**/*.{png,jpg,jpeg,webp,avif}');
const images=await Promise.all(photos.map(async photo=>{
 const load=loaders[`/src/assets/${photo.assetPath}`];if(!load)throw Error('Approved photo has no bundled source asset');
 const image=(await load()).default;const full=await getImage({src:image,width:Math.min(image.width,1920),format:'webp',quality:85});
 return {...photo,image,full};
}));
---
{images.length>0&&<div class="sp-photo-gallery" data-speaking-gallery aria-label={`${eventName} photographs`}>
 {images.map((photo,i)=><figure class:list={['sp-photo',{'sp-photo-featured':i===0}]}>
  <a href={photo.full.src} data-speaking-photo data-photo-alt={photo.alt} data-photo-caption={`${photo.caption} · ${photo.credit}`} aria-label={`Expand photo ${i+1} of ${images.length}: ${photo.alt}`}>
   <Image src={photo.image} widths={[320,640,960,1280].filter(n=>n<=photo.image.width)} sizes="(max-width: 640px) 90vw, 50vw" width={Math.min(photo.image.width,960)} format="webp" quality={78} alt={photo.alt} loading="lazy" decoding="async" data-speaking-image/>
   <span class="sp-image-fallback" hidden>Photo unavailable</span><span class="sp-expand" aria-hidden="true">↗</span>
  </a><figcaption>{photo.caption}<span>{photo.credit}</span></figcaption>
 </figure>)}
</div>}
