---
import { eventSchedule, scheduleCopy, eventDate } from "../../../data/hackathons";
import FormCta from "../FormCta.astro";
const phases = [
 { title: "Registration & Technical Qualification", mode: eventSchedule.registration.mode, start: eventSchedule.registration.start, end: eventSchedule.registration.end, dateLabel: scheduleCopy.registration, detail: "Participants register, complete mandatory technical qualification requirements and submit qualification evidence for organizer review." },
 { title: eventSchedule.submission.title, mode: eventSchedule.submission.mode, start: eventSchedule.submission.dates.value?.start, end: eventSchedule.submission.dates.value?.end, dateLabel: scheduleCopy.submission, detail: "Qualified participants submit their project or prototype along with the required evidence and demonstration material. Judges evaluate eligible submissions and select finalists." },
 { title: "Grand Finale", mode: eventSchedule.finale.mode, start: eventSchedule.finale.date, dateLabel: scheduleCopy.finale, detail: "Selected finalists demonstrate their solutions and present their work to the judging panel." },
];
---
<section class="hx-section" id="timeline" aria-labelledby="timeline-heading">
 <p class="hx-eyebrow">THE COMPETITION JOURNEY</p><h2 id="timeline-heading">From application to the final demo.</h2>
 <p class="hx-section-copy">Three phases. Qualification establishes readiness; competition judging evaluates the finished project.</p>
 <ol class="hx-competition-timeline" data-selection-note={scheduleCopy.selectionNote}>{phases.map((phase, i) => <li><span class="hx-step-number">Phase {i + 1}</span><div><h3>{phase.title}</h3><p><strong>{phase.start && phase.end ? <><time datetime={phase.start}>{eventDate(phase.start).replace(/, \d{4}$/, "")}</time> – <time datetime={phase.end}>{eventDate(phase.end)}</time></> : phase.start ? <time datetime={phase.start}>{phase.dateLabel}</time> : phase.dateLabel}</strong></p><p>{phase.detail}</p></div><span class="hx-status">{phase.mode}</span></li>)}</ol>
 <div class="hx-inline-note"><p>Final submissions require a working project. Prepare the full checklist before submitting.</p><FormCta kind="project" label="Submit Project" id="project-form-note"/></div>
</section>
<style is:inline>
 #timeline .hx-step-number { grid-column: 1 / -1; width: auto; }
 #timeline li > div { grid-column: 1 / -1; min-width: 0; }
 #timeline .hx-status { grid-column: 1 / -1; letter-spacing: .04em; }
</style>
