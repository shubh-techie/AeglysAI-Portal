---
import IntelligenceNetwork from "./IntelligenceNetwork.astro";
import FormCta from "../FormCta.astro";
import { asset } from "../../../data/project";
---
<section class="hx-hero" aria-labelledby="series-heading" id="series">
  <div class="container hx-hero-grid">
    <div>
      <div class="hx-event-brand"><img src={asset("brand/icons/icon-mark.png")} width="44" height="48" alt="AeglysAI"/><span>AEGLYSAI<span>HACKATHON / 2026</span></span></div><p class="hx-eyebrow">GLOBAL AI / ML / CYBERSECURITY INNOVATION</p>
      <h1 id="series-heading"><span>BUILD</span> <span>INTELLIGENCE.</span> <span class="hx-emphasis">SECURE</span> <span class="hx-emphasis">TOMORROW.</span></h1>
      <p class="hx-event-title">AEGLYSAI HACKATHON 2026</p><p class="hx-lead">Six challenges. One hackathon. Developers, students and innovators building practical intelligent solutions for a safer and more resilient digital future.</p>
      <div class="hx-actions"><FormCta kind="participant" label="Register for Hackathon" id="hero-form-note" primary/><a class="hx-button" href="#challenges">Explore Challenges <span aria-hidden="true">↓</span></a></div>
      <p class="hx-fine">Six challenges · Free participation · Teams of 1–4<br/>Any programming language · Mandatory individual prequalification<br/>Event dates to be announced</p>
    </div>
    <IntelligenceNetwork/>
  </div>
</section>
