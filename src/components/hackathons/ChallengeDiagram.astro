---
import {challengeVisuals} from '../../data/hackathonVisuals';
interface Props {id:string;scope?:string;}
const {id,scope='diagram'}=Astro.props;
const assets=import.meta.glob('../../assets/hackathon/*.svg',{query:'?raw',import:'default',eager:true});
const content=assets[`../../assets/hackathon/${id}.svg`] as string;
const visual=challengeVisuals[id];
if(!content||!visual||! /^[a-z0-9-]+$/.test(scope))throw Error('Unknown challenge diagram');
const svg=content.replaceAll(`${id}-`,`${scope}-${id}-`);
---
<figure class="challenge-diagram" data-challenge-diagram={id} data-accent={visual.accent} data-secondary={visual.secondary}>
 <div class="diagram-canvas" set:html={svg}/>
 <figcaption><span>Conceptual architecture</span><p>{visual.flow}</p></figcaption>
</figure>
<style>
.challenge-diagram{margin:0;--diagram-text:var(--text);--diagram-muted:var(--muted);--diagram-surface:var(--surface);--diagram-line:var(--line);--diagram-wash:light-dark(#edf3f8,#122033);--diagram-accent:light-dark(#1463a5,#87bcf2);--diagram-secondary:light-dark(#0b766c,#6ed4bc);}
[data-accent="indigo"]{--diagram-accent:light-dark(#4a51a8,#aab0fa);}[data-accent="violet"]{--diagram-accent:light-dark(#7051a0,#c4acf1);}[data-accent="cyan"]{--diagram-accent:light-dark(#076b88,#78d7e9);}[data-accent="orange"]{--diagram-accent:light-dark(#a45717,#eaba89);}
[data-secondary="violet"]{--diagram-secondary:light-dark(#7751a6,#c4acf1);}[data-secondary="blue"]{--diagram-secondary:light-dark(#255ea0,#87bcf2);}[data-secondary="green"]{--diagram-secondary:light-dark(#147453,#80dab6);}
.diagram-canvas{aspect-ratio:3/2;width:100%;}.diagram-canvas :global(svg){display:block;width:100%;height:auto;}figcaption{padding-top:12px;font-size:.8rem;line-height:1.6;color:var(--muted);}figcaption span{font-family:var(--mono);text-transform:uppercase;letter-spacing:.05em;font-size:.7rem;}figcaption p{margin:6px 0 0;}
</style>
