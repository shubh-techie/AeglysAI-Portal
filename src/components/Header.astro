---
import BrandMark from "./BrandMark.astro";
import ThemeControls from "./ThemeControls.astro";
import { href, navigation, project } from "../data/project";
const current = Astro.url.pathname.replace(/\/$/, "");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={href()} aria-label="AeglysAI home">
      <BrandMark />
      Aeglys<span>AI</span>
    </a>
    <nav aria-label="Main navigation">
      {navigation.map((item) => (
        <a
          href={href(item.path)}
          aria-current={
            current === href(item.path).replace(/\/$/, "") || (["speaking", "community"].includes(item.path) && current.startsWith(href(item.path))) ? "page" : undefined
          }
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a
      class="button button-small header-github"
      href={project.github}
      target="_blank"
      rel="noopener noreferrer"
    >
      View on GitHub <span aria-hidden="true">↗</span>
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
    <ThemeControls />
  </div>
</header>
