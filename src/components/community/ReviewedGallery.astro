---
interface Props { records:any[]; categories:string[]; kind:string; }
const {records,categories,kind}=Astro.props;
---
{records.length?<div class="review-gallery"><fieldset><legend>Filter {kind}</legend><label><input type="radio" name={kind} id={`${kind}-all`} checked/> All</label>{categories.filter(category=>records.some(record=>record.category===category)).map(category=><label><input type="radio" name={kind} id={`${kind}-${categories.indexOf(category)}`} data-filter={categories.indexOf(category)} /> {category}</label>)}</fieldset><div class="cards-grid three">{records.map(record=><article class="info-card reviewed-card" data-category={categories.indexOf(record.category)}><p class="eyebrow">Verified · {record.category}</p><h3>{record.title}</h3><p>{record.description}</p><p>{record.dateLabel??'Verified'}: <time datetime={record.verifiedAt}>{record.verifiedAt}</time></p>{record.provenanceDate&&<p>Provenance: {record.provenanceDate}</p>}{record.classification&&<p>Source: {record.classification} · Relationship: {record.independence}</p>}{record.outcome&&<p>{record.outcome}</p>}{record.highlights?.length&&<ul>{record.highlights.map((line:string)=><li>{line}</li>)}</ul>}{[['sourceUrl','Evidence'],['codeUrl','Public code'],['demoUrl','Demo'],['executionUrl','Execution evidence'],['reviewUrl','Review']].filter(([key])=>record[key]).map(([key,label])=><a class="text-link" href={record[key]} target="_blank" rel="noopener noreferrer">{label} ↗<span class="sr-only">: {record.title} (opens in a new tab)</span></a>)}{record.citations?.length&&<ul>{record.citations.map((citation:any)=><li><a href={citation.reference} target="_blank" rel="noopener noreferrer">Citation source ↗</a></li>)}</ul>}</article>)}</div></div>:<div class="notice"><h3>No reviewed {kind} records published</h3><p>Real evidence, verification and explicit publication permission are required. No sample projects, testimonials or adoption claims are shown.</p></div>}
<style>fieldset{border:0;padding:0;margin-bottom:24px;display:flex;gap:20px;flex-wrap:wrap;}label{min-height:44px;display:inline-flex;align-items:center;gap:8px;}article{display:flex;flex-direction:column;gap:12px;overflow-wrap:anywhere;}a{display:inline-flex;min-height:44px;align-items:center;}
.review-gallery:has(input[data-filter="0"]:checked) .reviewed-card:not([data-category="0"]),
.review-gallery:has(input[data-filter="1"]:checked) .reviewed-card:not([data-category="1"]),
.review-gallery:has(input[data-filter="2"]:checked) .reviewed-card:not([data-category="2"]),
.review-gallery:has(input[data-filter="3"]:checked) .reviewed-card:not([data-category="3"]),
.review-gallery:has(input[data-filter="4"]:checked) .reviewed-card:not([data-category="4"]),
.review-gallery:has(input[data-filter="5"]:checked) .reviewed-card:not([data-category="5"]) {display:none;}
</style>
