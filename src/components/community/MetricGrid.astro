---
import { snapshot } from '../../data/community/metrics';
const labels={stars:'Stars',forks:'Forks',pullRequests:'Pull requests (all states)',issues:'Issues (excluding PRs)',releases:'Published releases',externalContributors:'Non-owner contributor accounts',externalAttributedCommits:'Non-owner attributed commits'};
---
<div class="metrics-grid">{Object.entries(labels).map(([key,label])=><article class="info-card"><h3>{label}</h3><p class="metric-value">{snapshot?.metrics[key]??'Unavailable'}</p>{snapshot?<><p>Snapshot: <time datetime={snapshot.observedAt}>{snapshot.observedAt}</time></p><a class="text-link" href={snapshot.sources[key]} target="_blank" rel="noopener noreferrer">View source ↗<span class="sr-only">: {label} (opens in a new tab)</span></a></>:<p>No reviewed GitHub observation is published.</p>}</article>)}</div>
<p class="metric-note">Cumulative observations are not monthly activity. Non-owner accounts do not establish independence or third-party adoption. {snapshot?.traffic ? `Reviewed rolling 14-day traffic: ${snapshot.traffic.views.count} views (${snapshot.traffic.views.uniques} unique visitors), ${snapshot.traffic.clones.count} clones (${snapshot.traffic.clones.uniques} unique cloners). This is not calendar-month activity.` : 'GitHub traffic is unavailable without authorized collection.'}</p>
<style>.metrics-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr));gap:20px; } .metric-value { font-size:1.7rem;color:var(--cyan);overflow-wrap:anywhere; } article p,.metric-note { color:var(--muted);line-height:1.7; } time { overflow-wrap:anywhere; } @media(max-width:1023px){.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}@media(max-width:639px){.metrics-grid{grid-template-columns:1fr;}}</style>
