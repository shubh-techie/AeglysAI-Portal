---
interface Props { eyebrow: string; title: string; description: string; href: string; label: string; }
const {eyebrow,title,description,href,label}=Astro.props;
---
<article class="ed-feature">
  <div class="ed-feature-copy"><p class="ed-meta">{eyebrow}</p><h2>{title}</h2><p>{description}</p><slot name="status"/><a class="ed-link" href={href}>{label}<span aria-hidden="true"> ↗</span></a></div>
  <div class="ed-feature-visual"><slot name="visual"/></div>
</article>
